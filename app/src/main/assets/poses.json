        "top": {
          "head":  [0.746, 0.627],
          "neck":  [0.694, 0.646],
          "hip":   [0.450, 0.735],
          "elbow": [0.694, 0.751],
          "wrist": [0.694, 0.856],
          "knee":  [0.323, 0.781],

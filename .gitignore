# Local machine configuration. Holds the Android SDK path, and is where any
# secret would live later (Phase 4). Never commit this.
local.properties

# Build output
build/
app/build/
.gradle/
.kotlin/

# Gradle's own cache and downloaded distributions, kept inside the project on
# this machine because the C: drive is full. Several GB. Never committed.
GradleHome/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class

# Android Studio / IntelliJ
.idea/
*.iml
.cxx/

# Keystores. No signing key ever belongs in this repository.
*.jks
*.keystore

# OS noise
.DS_Store
Thumbs.db

# Logs and scratch
*.log
/scratch/

# The Samsung Health Data SDK. A licensed binary from Samsung, downloaded by
# hand and not ours to redistribute, so it stays out of the repository. See
# app/libs/README.md for where to get it. Phase 5 is optional; without this
# file the Samsung source set does not compile, which the README says.
app/libs/*.aar

# The owner's own protocol: start weight, target, heart-rate zones, bedtime,
# program dates. Health data about one person, so protocol.json in the repo
# carries sample numbers and this file overrides it locally. Same arrangement
# local.properties uses for the proxy secret.
app/src/main/assets/protocol.local.json

# The September export, superseded by the published GitHub repo. It carries its
# own .git, so it would land here as a broken submodule reference rather than
# as files. Kept on disk until confirmed unneeded; never committed.
/cutcoach/

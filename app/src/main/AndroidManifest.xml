<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The Samsung Health Data SDK declares minSdkVersion 29 and the rest of this
      app supports 28, which the brief asks for. Overriding keeps that promise
      rather than dragging the whole app up one API level for one optional
      phase: the Samsung feature is guarded at runtime and simply reports itself
      unavailable below 29.
    -->
    <uses-sdk tools:overrideLibrary="com.samsung.android.sdk.health.data" />

    <!--
      The only thing the app ever reaches the network for in Phase 1b is
      YouTube's own embedded player, showing a demo clip inside a cue card.
      Nothing is downloaded, cached or re-hosted, and the whole session player
      works in airplane mode.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The evening reminders: lamps down, phone out of the bedroom, lights out.
      Nothing else posts a notification, and no reminder ever suggests a later
      wake or a lie-in, which protocol.json forbids.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Health Connect, read only. Every string below was checked against the
      official documentation rather than recalled, because a wrong permission
      name does not fail to build: it fails silently at runtime with no data.

      There is deliberately no WRITE permission of any kind. The app reads what
      the watch recorded and never writes back into Health Connect.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!--
      Without this, reads are capped at the 30 days before the first grant, so
      a weight trend would start empty and stay short.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- So the daily sync can run without the app being opened. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Needed to see whether Health Connect is installed at all. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CutCoach">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CutCoach">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Health Connect will not show the permission sheet at all unless the
          app can explain what it does with the data. Both declarations are
          needed: the intent filter for Android 13 and below, and the alias for
          Android 14 and above, where the request comes through the platform.
        -->
        <activity
            android:name=".health.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.CutCoach">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>

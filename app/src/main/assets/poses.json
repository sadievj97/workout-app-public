{
  "meta": {
    "note": "Keyframe poses for the stick figures. Drawn in code with Compose Canvas; no image files and no third-party animation assets, so everything here works offline and can ship in a public repo.",
    "coordinate_space": "Normalised 0 to 1 inside a square box. x runs left to right, y runs top to bottom, so a larger y is lower on the screen. The floor is usually y 0.856.",
    "how_to_fix_a_pose": "Move the numbers, not the drawing code. Each joint is [x, y]. Limbs are drawn between joints: neck to hip is the torso, neck to elbow to wrist is the arm, hip to knee to ankle to toe is the leg. Keep the distance between two joints about the same across every pose of one exercise, or the limb will appear to stretch as it moves.",
    "review_status": "push_up, pull_up and hollow_hold are the first three, built for approval before the other twelve."
  },

  "figure": {
    "head_radius": 0.042,
    "stroke_width": 0.017,
    "segment_lengths_reference": {
      "torso": 0.26,
      "upper_arm": 0.105,
      "forearm": 0.105,
      "thigh": 0.135,
      "shin": 0.135,
      "foot": 0.05,
      "neck_to_head_centre": 0.055
    }
  },

  "exercises": {

